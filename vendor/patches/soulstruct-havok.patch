@@ -0,0 +1,117 @@
+"""Local addition: Havok 2010 resource-container types.
+
+These appear in animations exported with the Havok Content Tools (e.g. community-made FromSoft mod animations) as an
+extra 'Resource Data' named variant in the root container. FromSoft's own files never contain them, so Soulstruct did
+not define them. Layouts follow the Havok 2010.2 SDK (32-bit):
+
+    hkResourceBase : hkReferencedObject                  (8 bytes, no members)
+    hkResourceContainer : hkResourceBase                 (8 bytes, no members)
+    hkResourceHandle : hkResourceBase                    (8 bytes, no members)
+    hkMemoryResourceHandle::ExternalLink                 (8 bytes: memberName, externalId)
+    hkMemoryResourceHandle : hkResourceHandle            (28 bytes: variant @8, name @12, references @16)
+    hkMemoryResourceContainer : hkResourceContainer      (40 bytes: name @8, parent @12, resourceHandles @16, children @28)
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from soulstruct.havok.enums import *
+from .core import *
+
+
+@dataclass(slots=True, eq=False, repr=False, kw_only=True)
+class hkResourceBase(hkReferencedObject):
+    alignment = 4
+    byte_size = 8
+    tag_type_flags = TagDataType.Class
+
+    __tag_format_flags = 41
+
+    local_members = ()
+    members = hkReferencedObject.members
+
+
+@dataclass(slots=True, eq=False, repr=False, kw_only=True)
+class hkResourceContainer(hkResourceBase):
+    alignment = 4
+    byte_size = 8
+    tag_type_flags = TagDataType.Class
+
+    __tag_format_flags = 41
+
+    local_members = ()
+    members = hkResourceBase.members
+
+
+@dataclass(slots=True, eq=False, repr=False, kw_only=True)
+class hkResourceHandle(hkResourceBase):
+    alignment = 4
+    byte_size = 8
+    tag_type_flags = TagDataType.Class
+
+    __tag_format_flags = 41
+
+    local_members = ()
+    members = hkResourceBase.members
+
+
+@dataclass(slots=True, eq=False, repr=False, kw_only=True)
+class hkMemoryResourceHandleExternalLink(hk):
+    alignment = 4
+    byte_size = 8
+    tag_type_flags = TagDataType.Class
+
+    __tag_format_flags = 41
+    __real_name = "hkMemoryResourceHandle::ExternalLink"
+
+    local_members = (
+        Member(0, "memberName", hkStringPtr),
+        Member(4, "externalId", hkStringPtr),
+    )
+    members = local_members
+
+    memberName: str
+    externalId: str
+
+
+@dataclass(slots=True, eq=False, repr=False, kw_only=True)
+class hkMemoryResourceHandle(hkResourceHandle):
+    alignment = 4
+    byte_size = 28
+    tag_type_flags = TagDataType.Class
+
+    __tag_format_flags = 41
+
+    local_members = (
+        Member(8, "variant", hkRefVariant),
+        Member(12, "name", hkStringPtr),
+        Member(16, "references", hkArray(hkMemoryResourceHandleExternalLink)),
+    )
+    members = hkResourceHandle.members + local_members
+
+    variant: hkReferencedObject
+    name: str
+    references: list[hkMemoryResourceHandleExternalLink]
+
+
+@dataclass(slots=True, eq=False, repr=False, kw_only=True)
+class hkMemoryResourceContainer(hkResourceContainer):
+    alignment = 4
+    byte_size = 40
+    tag_type_flags = TagDataType.Class
+
+    __tag_format_flags = 41
+
+    local_members = (
+        Member(8, "name", hkStringPtr),
+        Member(12, "parent", Ptr(DefType("hkMemoryResourceContainer", lambda: hkMemoryResourceContainer)),
+               MemberFlags.NotSerializable),
+        Member(16, "resourceHandles", hkArray(Ptr(hkMemoryResourceHandle))),
+        Member(28, "children", hkArray(Ptr(DefType("hkMemoryResourceContainer", lambda: hkMemoryResourceContainer)))),
+    )
+    members = hkResourceContainer.members + local_members
+
+    name: str
+    parent: hkMemoryResourceContainer
+    resourceHandles: list[hkMemoryResourceHandle]
+    children: list[hkMemoryResourceContainer]
