diff --git a/oozdec.cpp b/oozdec.cpp
new file mode 100644
index 0000000..3f3a626
--- /dev/null
+++ b/oozdec.cpp
@@ -0,0 +1,17 @@
+// oozdec: decompress a raw Oodle (Kraken/Mermaid/Selkie/Leviathan) stream, as stored in FromSoftware DCX "KRAK"
+// payloads.   usage: oozdec IN OUT UNCOMPRESSED_SIZE
+#include "stdafx.h"
+int Kraken_Decompress(const byte *src, size_t src_len, byte *dst, size_t dst_len);
+int main(int argc, char **argv) {
+  if (argc != 4) { fprintf(stderr, "usage: oozdec IN OUT UNCOMPRESSED_SIZE\n"); return 2; }
+  FILE *f = fopen(argv[1], "rb"); if (!f) { perror(argv[1]); return 1; }
+  fseeko(f, 0, SEEK_END); size_t n = ftello(f); fseeko(f, 0, SEEK_SET);
+  byte *src = (byte *)malloc(n + 64); size_t rd = fread(src, 1, n, f); fclose(f);
+  if (rd != n) { fprintf(stderr, "short read\n"); return 1; }
+  size_t out_len = strtoull(argv[3], nullptr, 10);
+  byte *dst = (byte *)malloc(out_len + 64);
+  int got = Kraken_Decompress(src, n, dst, out_len);
+  if (got < 0 || (size_t)got != out_len) { fprintf(stderr, "decompress failed: got %d of %zu\n", got, out_len); return 1; }
+  FILE *o = fopen(argv[2], "wb"); fwrite(dst, 1, out_len, o); fclose(o);
+  return 0;
+}
